# Isolated synthetic local development only — never use these example values in production
AEGIS_MODE=development
AEGIS_API_KEYS={"local-dev-only-key":{"tenant":"sandbox","role":"admin"},"local-analyst-only-key":{"tenant":"sandbox","role":"analyst"},"local-service-only-key":{"tenant":"sandbox","role":"service"}}
AEGIS_DB_PATH=aegis.db

# Real browser WebAuthn: origin must match the URL used to open the dashboard
AEGIS_RP_ID=localhost
AEGIS_ORIGIN=http://localhost:8080

# For staging generate a fresh 32+ byte random secret outside Git; never use a public sample secret.
# AEGIS_REFERENCE_HMAC_KEY=(set privately outside this file)
AEGIS_RATE_LIMIT_PER_MINUTE=120

# Valid source signatures require a separately provisioned Ed25519 source public key
AEGIS_TELEMETRY_SIGNERS={}

# Staging (not customer production) additionally requires real external OIDC issuer
# AEGIS_OIDC_ISSUER=https://your-idp.example.com/
# AEGIS_OIDC_AUDIENCE=aegis-api
# AEGIS_OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# Do not configure AEGIS_API_KEYS in staging
